<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dsr_robotiq2f</name>
  <version>0.1.0</version>
  <description>Robotiq 2F-85 gripper driver (Modbus RTU over USB/RS-485) with a ROS 2 node, GripperCommand action and state topics.</description>
  <maintainer email="noreply@example.com">sksub</maintainer>
  <license>Apache License 2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>control_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>std_srvs</depend>
  <exec_depend>python3-pymodbus</exec_depend>
  <exec_depend>python3-serial</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
